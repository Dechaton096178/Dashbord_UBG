 {
  "id": "5b303c2ec52cfd22",
  "type": "function",
  "z": "d05c3eb2b55f50ba",
  "name": "ตัดสิน OK / NG",
  "func": "// @ts-nocheck\n// ===== ตัดสินผลชั่ง -> สีไฟ Tower =====\n// รับ msg.payload = { weight, unit, stable } จาก flow Extruder03 (ผ่าน link) หรือจากปุ่มทดสอบ\n// ส่งออกเฉพาะเมื่อสีเปลี่ยน: \"green\" | \"red\" | \"off\"\nconst MIN_G = 40.0;      // Spec ต่ำสุด (กรัม)  *** ภายหลังจะดึงจากตาราง Spec ตามรุ่นของ Batch ***\nconst MAX_G = 41.0;      // Spec สูงสุด (กรัม)\nconst EMPTY_G = 1.0;     // ไม่เกินค่านี้ = ไม่มีของบนเครื่องชั่ง -> ดับไฟ\n\nconst p = msg.payload || {};\nif (p.weight === null || p.weight === undefined || isNaN(p.weight)) return null;\nconst g = String(p.unit || \"g\").toLowerCase() === \"kg\" ? p.weight * 1000 : p.weight;\n\nlet color;\nif (g <= EMPTY_G) color = \"off\";\nelse if (!p.stable) return null;                       // ยังไม่นิ่ง -> คงสีเดิมไว้\nelse color = (g >= MIN_G && g <= MAX_G) ? \"green\" : \"red\";\n\nif (context.get(\"last\") === color) return null;        // สีเดิม ไม่ต้องสั่งซ้ำ\ncontext.set(\"last\", color);\nnode.status({ fill: color === \"off\" ? \"grey\" : color, shape: \"dot\",\n              text: color.toUpperCase() + (color === \"off\" ? \"\" : \"  \" + g + \" g  (\" + MIN_G + \"–\" + MAX_G + \")\") });\nreturn { payload: color, weight: g };",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 410,
  "y": 360,
  "wires": [
   [
    "6344501f196afb37"
   ]
  ]
 },
