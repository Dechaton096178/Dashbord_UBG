 {
  "id": "6344501f196afb37",
  "type": "function",
  "z": "d05c3eb2b55f50ba",
  "name": "คุมไฟ (กันติดพร้อมกัน)",
  "func": "// @ts-nocheck\n// ===== คุมไฟ Tower: DO1 = เขียว, DO2 = แดง =====\n// msg.payload: \"green\" | \"red\" | \"off\"  (หรือ true/false สำหรับทดสอบ)\n// กันไฟติดพร้อมกัน: ปิดดวงหนึ่งก่อน แล้วค่อยเปิดอีกดวง\nconst c = String(msg.payload).toLowerCase();\nconst OFF = { payload: false }, ON = { payload: true };\nif (c === \"green\") {\n    node.send([null, OFF]);            // ปิดแดงก่อน\n    node.send([ON, null]);             // เปิดเขียว\n} else if (c === \"red\") {\n    node.send([OFF, null]);            // ปิดเขียวก่อน\n    node.send([null, ON]);             // เปิดแดง\n} else {\n    node.send([OFF, OFF]);             // ดับทั้งคู่\n}\nnode.status({ fill: c === \"green\" ? \"green\" : c === \"red\" ? \"red\" : \"grey\", shape: \"dot\", text: c === \"green\" || c === \"red\" ? c.toUpperCase() : \"OFF\" });\nreturn null;",
  "outputs": 2,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 400,
  "y": 150,
  "wires": [
   [
    "03858fd58e53fbce"
   ],
   [
    "d34860f3c040ad6f"
   ]
  ]
 },
